<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      The SecureVault mark: a shield whose interior is a vault door — a bolted ring around a
      keyhole. Shield for protection, vault door for what is being protected, keyhole for who can
      open it, in one silhouette.

      Drawn inside the 72dp safe zone of the 108dp adaptive-icon canvas so the launcher can mask
      and animate it without clipping. Same geometry and palette as the desktop PNG assets; the
      two are the same mark, not two similar ones.
    -->

    <!-- Shield body -->
    <path
        android:fillColor="#6FD3C6"
        android:pathData="M54,22 L76,29 L76,52 C76,66 67,78 54,85 C41,78 32,66 32,52 L32,29 Z" />
    <path
        android:strokeColor="#103029"
        android:strokeWidth="3.2"
        android:fillColor="#00000000"
        android:pathData="M54,22 L76,29 L76,52 C76,66 67,78 54,85 C41,78 32,66 32,52 L32,29 Z" />

    <!-- Vault door ring -->
    <path
        android:strokeColor="#103029"
        android:strokeWidth="3.4"
        android:fillColor="#00000000"
        android:pathData="M54,36 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />
    <path
        android:strokeColor="#1F6F66"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M54,36 m-12.2,0 a12.2,12.2 0 1,0 24.4,0 a12.2,12.2 0 1,0 -24.4,0" />

    <!-- Four bolts on the diagonals -->
    <path android:strokeColor="#103029" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M45.2,27.2 L48.6,30.6" />
    <path android:strokeColor="#103029" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M62.8,27.2 L59.4,30.6" />
    <path android:strokeColor="#103029" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M45.2,44.8 L48.6,41.4" />
    <path android:strokeColor="#103029" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M62.8,44.8 L59.4,41.4" />

    <!-- Keyhole -->
    <path
        android:fillColor="#103029"
        android:pathData="M54,33 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
    <path
        android:fillColor="#103029"
        android:pathData="M52.2,35 L55.8,35 L56.6,42 L51.4,42 Z" />
</vector>
